# Copy to .env and fill in your DashScope (Bailian) API key.
# Real environment variables always take precedence over this file.

DASHSCOPE_API_KEY=sk-your-key-here

# Optional hotwords / glossary (the only two ways to enable them, besides the
# --hotwords / --glossary CLI flags). Paths are relative to where you run
# videotrans, or absolute.
OIL_SUBTITLE_HOTWORDS=./hotwords.json
OIL_SUBTITLE_GLOSSARY=./glossary.json
